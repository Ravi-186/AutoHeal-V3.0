# AutoHeal Enterprise Configuration
ENVIRONMENT=production
AUTOHEAL_API_HOST=0.0.0.0
AUTOHEAL_API_PORT=8000
AUTOHEAL_DASHBOARD_PORT=8501

# AI & Detection Engine
AUTOHEAL_DETECTION_THRESHOLD=0.45
AUTOHEAL_MAX_RETRIES=2
AUTOHEAL_TRAFFIC_DURATION=5

# Logging & Observability
AUTOHEAL_LOG_LEVEL=INFO
AUTOHEAL_ALLOWED_ORIGINS=*
